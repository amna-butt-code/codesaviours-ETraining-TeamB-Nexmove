{
  "info": {
    "name": "Nexmove - Zohaib public APIs",
    "description": "Public endpoints for FAQs, conditions and contact messages. Start the server and run the seed script first. Set the baseUrl collection variable if your port differs. No auth needed for these routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "faqId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Expected: 200 and { status: 'ok', project: 'Nexmove' }"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "FAQs",
      "item": [
        {
          "name": "List FAQs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs"
              ]
            },
            "description": "Expected: 200, success true, a data array and pagination. Saves the first FAQ id for the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"success true and data is an array\", () => { pm.expect(b.success).to.be.true; pm.expect(b.data).to.be.an(\"array\"); });",
                  "pm.test(\"Has pagination\", () => pm.expect(b.pagination).to.include.keys(\"page\",\"limit\",\"total\",\"pages\"));",
                  "pm.test(\"Has at least one FAQ (run the seed script first)\", () => pm.expect(b.pagination.total).to.be.above(0));",
                  "if (b.data.length) { pm.collectionVariables.set(\"faqId\", b.data[0]._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List FAQs by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs?category=Booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Booking"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Every item is in the Booking category\", () => pm.response.json().data.forEach(f => pm.expect(f.category).to.eql(\"Booking\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "List FAQs - limit is capped at 50",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs?limit=999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "999"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"limit capped at 50\", () => pm.expect(pm.response.json().pagination.limit).to.eql(50));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get FAQ by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs/{{faqId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs",
                "{{faqId}}"
              ]
            },
            "description": "Run 'List FAQs' first so faqId is set."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested FAQ\", () => pm.expect(pm.response.json().data._id).to.eql(pm.collectionVariables.get(\"faqId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get FAQ - invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Friendly message\", () => pm.expect(pm.response.json().message).to.include(\"doesn't look right\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get FAQ - id not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs",
                "000000000000000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Conditions",
      "item": [
        {
          "name": "List conditions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conditions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conditions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Has conditions (run the seed script first)\", () => pm.expect(b.data.length).to.be.above(0));",
                  "pm.test(\"List items carry only title, slug, summary\", () => { const c = b.data[0]; pm.expect(c).to.include.keys(\"title\",\"slug\",\"summary\"); pm.expect(c).to.not.have.property(\"description\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get condition by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conditions/lower-back-pain",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conditions",
                "lower-back-pain"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().data;",
                  "pm.test(\"Full record returned\", () => { pm.expect(c.slug).to.eql(\"lower-back-pain\"); pm.expect(c).to.have.property(\"description\"); });",
                  "pm.test(\"Internal flag is hidden\", () => pm.expect(c).to.not.have.property(\"isPublished\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get condition - not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conditions/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conditions",
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get condition - invalid slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conditions/Bad_Slug!",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conditions",
                "Bad_Slug!"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Contact - invalid input",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"bad\",\n  \"text\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Field-level errors for name, email and text\", () => pm.expect(pm.response.json().errors).to.include.keys(\"name\",\"email\",\"text\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Contact - injection attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\n    \"$gt\": \"\"\n  },\n  \"email\": \"a@b.com\",\n  \"text\": \"This is a test message\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Objects are rejected\", () => pm.expect(pm.response.json().errors.name).to.eql(\"This field must be text.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Contact - honeypot filled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            },
            "description": "Returns a fake success and saves nothing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bot\",\n  \"email\": \"bot@example.com\",\n  \"text\": \"Buy cheap stuff now please\",\n  \"website\": \"http://spam.example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Contact - valid message (writes to the database)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            },
            "description": "Saves a real document in the shared database. Delete it in Atlas afterwards. The contact route allows 5 requests per IP per hour; restart the server to reset the counter.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"text\": \"[Postman test] Hello, this is a test message.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Thank-you message\", () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}